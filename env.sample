# SirBloggsAlot environment — sample / reference.
# Copy the values you need into a gitignored `.env` (local) and /etc/sirbloggsalot.env (prod).
# Never commit real secrets. Load locally with:  set -a; . ./.env; set +a; node server.js

# ---- Auth (existing, required) ----
SIR_BLOGGS_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
SIR_BLOGGS_AUTH_SESSION_SECRET=long-random-string-do-not-rotate-casually
SIR_BLOGGS_AUTH_ADMIN_EMAILS=you@example.com

# ---- Product surface ----
# Set to 1 to serve the Blawgy SPA as the product (Phase 1). Unset = custom dashboard.
SIR_BLOGGS_ENABLE_BLAWGY_CLIENT=1

# ---- Store paths (prod points these at the writable StateDirectory) ----
SIR_BLOGGS_AUTH_STORE_PATH=/var/lib/sirbloggsalot/auth-store.json
SIR_BLOGGS_ACCOUNT_STORE_PATH=/var/lib/sirbloggsalot/account-store.json
SIR_BLOGGS_BLAWGY_STORE_PATH=/var/lib/sirbloggsalot/blawgy-store.json

# ---- Phase 1 real integrations (the core loop) ----
# Keyword research (DataForSEO, HTTP Basic). One account later also powers
# rank tracking + AI-mentions.
DATAFORSEO_LOGIN=your-dataforseo-login
DATAFORSEO_PASSWORD=your-dataforseo-password

# LLM for article generation + onboarding intelligence. Pick ONE of:
#   a) the local `codex` CLI (no API key needed; must be installed + authed on the
#      host — great for local/dev, not for the EC2 box unless codex is set up there):
SIR_BLOGGS_LLM_PROVIDER=codex
#   b) an API key (auto-detected; Anthropic preferred when both are set):
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# Optional model override (codex uses its own default unless set):
# SIR_BLOGGS_LLM_MODEL=claude-sonnet-5
# Optional codex binary path (defaults to `codex` on PATH):
# SIR_BLOGGS_CODEX_BIN=/Users/you/.local/bin/codex

# ---- Optional ----
# SIR_BLOGGS_CRAWL_USER_AGENT=SirBloggsAlotBot/1.0 (+https://sirbloggsalot.com)
